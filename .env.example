# ──────────────────────────────────────────────────────────────
# Kirana WhatsApp Billing Agent — Environment Variables
# ──────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in the values.
# NEVER prefix secrets with NEXT_PUBLIC_ — all values are server-side only.

# ── Supabase ──────────────────────────────────────────────────
# Project URL and service role key from your Supabase dashboard.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Twilio ────────────────────────────────────────────────────
# Account SID and Auth Token from https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The WhatsApp Sandbox number (e.g. whatsapp:+14155238886)
TWILIO_WHATSAPP_NUMBER=
# Public HTTPS origin (no trailing slash) where Twilio sends webhooks.
# Local: your ngrok/tunnel URL. Production: your Vercel deployment URL.
TWILIO_WEBHOOK_BASE_URL=

# ── Groq ──────────────────────────────────────────────────────
# Used for voice transcription, bill photo reading, and LLM text extraction.
# Switched from OpenAI to Groq for all AI calls due to credit/billing constraints.
GROQ_API_KEY=

# ── Debug console ─────────────────────────────────────────────
# Required to use /dev/test after deployment. Optional in local development.
DEV_TEST_ACCESS_TOKEN=
